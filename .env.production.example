# Embedding Server Production Environment Variables
# Copy this file to .env.production and fill in your actual values
# DO NOT commit .env.production to git

# ============================================
# Server Configuration
# ============================================
# Port to run the server on
PORT=5001

# Python unbuffered output (recommended for Docker)
PYTHONUNBUFFERED=1

# ============================================
# Model Configuration
# ============================================
# Model name (default: all-mpnet-base-v2)
# Options: all-mpnet-base-v2 (768 dim, high quality), all-MiniLM-L6-v2 (384 dim, faster)
# MODEL_NAME=all-mpnet-base-v2

# Model cache directories
TRANSFORMERS_CACHE=/home/appuser/.cache/torch/sentence_transformers
HF_HOME=/home/appuser/.cache/huggingface
TORCH_HOME=/home/appuser/.cache/torch

# ============================================
# Gunicorn Configuration (Production Dockerfile)
# ============================================
# Number of worker processes (default: 1 for memory efficiency)
# GUNICORN_WORKERS=1

# Number of threads per worker (default: 4)
# GUNICORN_THREADS=4

# Worker timeout in seconds (default: 300 for model loading)
# GUNICORN_TIMEOUT=300

# ============================================
# Performance Configuration
# ============================================
# Enable GPU if available (auto-detected, but can force CPU)
# CUDA_VISIBLE_DEVICES=

# Memory limit (optional, for monitoring)
# MEMORY_LIMIT=3G

# ============================================
# Logging Configuration
# ============================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# ============================================
# Security Configuration
# ============================================
# API key for authentication (optional - implement in app.py if needed)
# API_KEY=your_api_key_here

# Allowed origins for CORS (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ============================================
# Notes
# ============================================
# - Most settings have sensible defaults
# - PORT is the only required variable
# - Model (all-mpnet-base-v2) will be downloaded automatically on first use (~420MB)
# - First startup takes 1-2 minutes for model download and loading
# - Subsequent startups are faster (~30 seconds) if model cache is persisted
# - Health check available at /health endpoint
